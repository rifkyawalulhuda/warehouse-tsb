# Template konfigurasi produksi. Salin ke `.env.production` lalu isi nilainya.
#   cp .env.production.example .env.production
# Jangan commit `.env.production`.

# --- Database (dipakai kontainer db dan api) ---
POSTGRES_USER=tsb
POSTGRES_PASSWORD=ganti-dengan-password-panjang-acak
POSTGRES_DB=warehouse_tsb

# --- URL publik ---
# Domain HTTPS hasil Cloudflare Tunnel, dipakai untuk tautan tiket WhatsApp.
APP_ORIGIN=https://gudang.contoh.com
PUBLIC_APP_URL=https://gudang.contoh.com

# Port nginx di host. Cloudflare Tunnel diarahkan ke http://localhost:8080.
WEB_PORT=8080

# --- Auth ---
# WAJIB diganti. Buat dengan: openssl rand -base64 48
JWT_ACCESS_SECRET=ganti-dengan-48-byte-acak-untuk-access-token
JWT_REFRESH_SECRET=ganti-dengan-48-byte-acak-untuk-refresh-token
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
