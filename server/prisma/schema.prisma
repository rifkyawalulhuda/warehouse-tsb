// Skema database Warehouse TSB.
// Sumber: docs/prd/arsitektur_sistem_skema_database.md dengan tiga koreksi yang
// tercatat di docs/rencana-implementasi.md:
//   1. slot_allocations  -> baris yang dikunci saat booking (menggantikan "lock baris settings")
//   2. kuota dihitung dari master dock, bukan angka manual di settings
//   3. early_arrival_limit_minutes -> batas kedatangan terlalu awal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  GATE_OFFICER
  CHECKER
}

enum ActivityType {
  LOADING
  UNLOADING
}

enum DockActivity {
  LOADING
  UNLOADING
  BOTH
}

enum DockStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  BOOKED_INCOMPLETE
  BOOKED_READY
  CHECKED_IN_ON_TIME
  LATE_WAITING_LIST
  DOCK_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

/// Kebijakan persetujuan booking di tingkat gudang.
/// AUTO   = perilaku awal: semua booking langsung sah.
/// MANUAL = hanya customer yang di-whitelist (auto_approve_booking) yang otomatis.
enum ApprovalMode {
  AUTO
  MANUAL
}

/// Sumbu status persetujuan, terpisah dari BookingStatus supaya 18 pemanggil
/// BookingStatus tidak perlu diubah. Lihat docs/rencana-approval-booking.md §1.
enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Perusahaan customer. Akun login (`User` ber-role CUSTOMER) menempel ke satu
/// customer; booking dimiliki customer, bukan akun.
model Customer {
  id   String @id @default(uuid()) @db.Uuid
  /// Kode tampilan berurutan, mis. CUST-001. Tidak dipakai ulang setelah hapus.
  code String @unique @db.VarChar(24)
  /// Nama perusahaan. Unik — dijaga juga oleh indeks `lower(name)` di migrasi,
  /// karena `@unique` saja tidak case-insensitive.
  name String @unique @db.VarChar(160)

  address String? @db.VarChar(240)
  city    String? @db.VarChar(80)
  picName String? @map("pic_name") @db.VarChar(120)
  phone   String? @db.VarChar(24)
  /// Email perusahaan. BUKAN identitas login — login memakai `users.email`.
  email   String? @db.VarChar(160)
  taxId   String? @map("tax_id") @db.VarChar(40)
  note    String? @db.VarChar(240)

  isActive Boolean @default(true) @map("is_active")
  /// Whitelist approval: saat approval_mode = MANUAL, booking perusahaan ini
  /// tidak perlu antre. Pindah dari `users` (lihat rencana §1 keputusan 5).
  autoApproveBooking Boolean @default(false) @map("auto_approve_booking")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  users    User[]
  bookings Booking[] @relation("CustomerBookings")

  @@map("customers")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  phone        String?  @db.VarChar(24)
  passwordHash String   @map("password_hash") @db.VarChar(120)
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  /// Memberi hak approve ke non-ADMIN. Role ADMIN selalu berhak tanpa flag ini.
  canApproveBooking  Boolean @default(false) @map("can_approve_booking")

  /// Perusahaan tempat akun CUSTOMER ini bekerja. Wajib untuk CUSTOMER,
  /// NULL untuk Admin/Security/Checker.
  customerId String?  @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Booking yang DIBUAT akun ini. Kepemilikan bisnis ada di `Booking.customer`.
  createdBookings   Booking[]      @relation("BookingCreator")
  approvals         Booking[]      @relation("BookingApprovals")
  gateInLogs        BookingTimeLog[] @relation("GateInBy")
  dockAssignLogs    BookingTimeLog[] @relation("DockAssignedBy")
  processStartLogs  BookingTimeLog[] @relation("ProcessStartedBy")
  processDoneLogs   BookingTimeLog[] @relation("ProcessCompletedBy")
  gateOutLogs       BookingTimeLog[] @relation("GateOutBy")
  auditLogs         AuditLog[]
  scanAttempts      ScanAttempt[]

  @@index([customerId])
  @@map("users")
}

/// Satu baris saja (id = 1). Jam disimpan sebagai menit dari tengah malam waktu Jakarta
/// supaya aritmetika blok tidak bergantung pada zona waktu database.
model WarehouseSetting {
  id                       Int    @id @default(1)
  warehouseName            String @default("Gudang Utama") @map("warehouse_name") @db.VarChar(120)

  /// Judul aplikasi yang tampil di header, halaman masuk, dan judul tab.
  appName                  String  @default("Warehouse TSB") @map("app_name") @db.VarChar(60)
  appTagline               String  @default("Time Slot Booking") @map("app_tagline") @db.VarChar(80)
  /// Nama pendek untuk judul tab dan layar sempit. Kosong = pakai appName.
  appShortName             String? @map("app_short_name") @db.VarChar(20)
  operatingStartMinute     Int    @default(480) @map("operating_start_minute")
  operatingEndMinute       Int    @default(1020) @map("operating_end_minute")
  slotUnitMinutes          Int    @default(30) @map("slot_unit_minutes")
  gracePeriodMinutes       Int    @default(15) @map("grace_period_minutes")
  earlyArrivalLimitMinutes Int    @default(60) @map("early_arrival_limit_minutes")
  bookingWindowDays        Int    @default(7) @map("booking_window_days")

  /// Kebijakan persetujuan booking. Rilis sebagai AUTO supaya perilaku tidak berubah.
  approvalMode              ApprovalMode @default(AUTO) @map("approval_mode")
  /// Keputusan Admin harus selesai minimal N menit sebelum jam kedatangan.
  approvalLeadMinutes       Int          @default(30) @map("approval_lead_minutes")
  /// Jendela keputusan minimum sejak booking dibuat, agar booking mendesak tetap bisa diputuskan.
  approvalMinDecisionMinutes Int         @default(15) @map("approval_min_decision_minutes")
  /// Ambang label "MENDESAK" di antrean (hanya memengaruhi badge, bukan keputusan).
  approvalUrgentBufferMinutes Int        @default(1440) @map("approval_urgent_buffer_minutes")

  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("warehouse_settings")
}

model TruckType {
  id              Int     @id @default(autoincrement())
  truckName       String  @map("truck_name") @db.VarChar(80)
  durationMinutes Int     @map("duration_minutes")
  blocksRequired  Int     @map("blocks_required")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  bookings Booking[]

  @@map("truck_types")
}

/**
 * Daftar gudang tempat dock berada. Sekadar metadata untuk Master Data —
 * kuota, booking, dan laporan tetap dihitung untuk satu gudang seperti sebelumnya,
 * sehingga menambah gudang baru tidak mengubah mesin kuota sama sekali.
 */
model Warehouse {
  id       Int    @id @default(autoincrement())
  name     String @unique @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")

  docks Dock[]

  @@map("warehouses")
}

model Dock {
  id              Int          @id @default(autoincrement())
  dockCode        String       @unique @map("dock_code") @db.VarChar(20)
  allowedActivity DockActivity @map("allowed_activity")
  currentStatus   DockStatus   @default(AVAILABLE) @map("current_status")
  /// Nama area di dalam gudang, mis. "Area B". Teks bebas, boleh kosong.
  areaName        String?      @map("area_name") @db.VarChar(80)

  warehouseId Int       @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  bookings Booking[] @relation("AssignedDock")

  @@map("docks")
}

model Booking {
  id          String   @id @default(uuid()) @db.Uuid
  bookingCode String   @unique @map("booking_code") @db.VarChar(24)
  qrToken     String   @unique @map("qr_token") @db.VarChar(64)

  /// Pemilik bisnis booking: perusahaan customer.
  customerId    String       @map("customer_id") @db.Uuid
  /// Akun yang menekan tombol booking. Dipakai untuk jejak, bukan kepemilikan.
  createdById   String       @map("created_by_id") @db.Uuid
  activityType ActivityType @map("activity_type")
  truckTypeId  Int          @map("truck_type_id")

  /// Tanggal operasional (zona Jakarta), tanpa komponen jam.
  bookingDate DateTime @map("booking_date") @db.Date
  /// Instant UTC dari jam mulai yang dipilih (Jakarta).
  startTime   DateTime @map("start_time") @db.Timestamptz(3)
  endTime     DateTime @map("end_time") @db.Timestamptz(3)

  referenceDocNo String  @map("reference_doc_no") @db.VarChar(80)
  licensePlate   String? @map("license_plate") @db.VarChar(20)
  driverName     String? @map("driver_name") @db.VarChar(120)
  driverPhone    String? @map("driver_phone") @db.VarChar(24)

  /// Snapshot jumlah blok 30 menit yang dikunci saat booking dibuat.
  /// Tanpa kolom ini, mengubah `truck_types.blocks_required` akan mengubah
  /// jumlah blok yang dilepas saat pembatalan/NO_SHOW dan membuat kuota bocor.
  blocksLocked Int @map("blocks_locked")

  assignedDockId Int?   @map("assigned_dock_id")
  status         BookingStatus
  lateMinutes    Int    @default(0) @map("late_minutes")

  /// Sumbu persetujuan, ortogonal terhadap status. Default NOT_REQUIRED agar
  /// booking tanpa antrean (mode AUTO / whitelist / data lama) tidak berubah.
  approvalStatus   ApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  /// Batas waktu keputusan Admin. Null bila approvalStatus = NOT_REQUIRED.
  approvalDeadline DateTime?      @map("approval_deadline") @db.Timestamptz(3)
  approvedById     String?        @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz(3)
  /// Wajib terisi bila approvalStatus = REJECTED.
  rejectionReason  String?        @map("rejection_reason") @db.VarChar(240)
  /// Guard agar kuota dirilis tepat sekali (keputusan grilling 2.2 / rencana §4.3).
  quotaReleasedAt  DateTime?      @map("quota_released_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     Customer        @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User            @relation("BookingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  truckType    TruckType       @relation(fields: [truckTypeId], references: [id])
  assignedDock Dock?           @relation("AssignedDock", fields: [assignedDockId], references: [id])
  approvedBy   User?           @relation("BookingApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  timeLog      BookingTimeLog?
  auditLogs    AuditLog[]
  scanAttempts ScanAttempt[]

  @@index([bookingDate, status])
  @@index([customerId, bookingDate])
  @@index([createdById])
  @@index([status, startTime])
  @@index([approvalStatus, approvalDeadline])
  @@index([approvalStatus, bookingDate])
  @@map("bookings")
}

model BookingTimeLog {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @unique @map("booking_id") @db.Uuid

  vehicleCompletedAt   DateTime? @map("vehicle_completed_at") @db.Timestamptz(3)
  gateInAt             DateTime? @map("gate_in_at") @db.Timestamptz(3)
  gateInBy             String?   @map("gate_in_by") @db.Uuid
  dockAssignedAt       DateTime? @map("dock_assigned_at") @db.Timestamptz(3)
  dockAssignedBy       String?   @map("dock_assigned_by") @db.Uuid
  processStartedAt     DateTime? @map("process_started_at") @db.Timestamptz(3)
  processStartedBy     String?   @map("process_started_by") @db.Uuid
  processCompletedAt   DateTime? @map("process_completed_at") @db.Timestamptz(3)
  processCompletedBy   String?   @map("process_completed_by") @db.Uuid
  gateOutAt            DateTime? @map("gate_out_at") @db.Timestamptz(3)
  gateOutBy            String?   @map("gate_out_by") @db.Uuid

  booking          Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  gateInUser       User?   @relation("GateInBy", fields: [gateInBy], references: [id])
  dockAssignedUser User?   @relation("DockAssignedBy", fields: [dockAssignedBy], references: [id])
  processStartedUser User? @relation("ProcessStartedBy", fields: [processStartedBy], references: [id])
  processCompletedUser User? @relation("ProcessCompletedBy", fields: [processCompletedBy], references: [id])
  gateOutUser      User?   @relation("GateOutBy", fields: [gateOutBy], references: [id])

  /// Riwayat gate disaring menurut jam masuk/keluar, bukan tanggal booking:
  /// truk shift malam bisa masuk setelah tengah malam.
  @@index([gateInAt])
  @@index([gateOutAt])
  @@map("booking_time_logs")
}

/// Pemakaian kuota per blok 30 menit. Inilah baris yang dikunci
/// (SELECT ... FOR UPDATE) saat booking dibuat, dibatalkan, atau dinilai NO_SHOW.
model SlotAllocation {
  id           Int          @id @default(autoincrement())
  slotDate     DateTime     @map("slot_date") @db.Date
  activity     ActivityType
  /// Menit dari tengah malam waktu Jakarta, misal 540 = 09:00.
  slotStartMinute Int       @map("slot_start_minute")
  /// Snapshot kapasitas saat baris dibuat agar laporan historis tidak berubah.
  capacity     Int
  used         Int          @default(0)

  @@unique([slotDate, activity, slotStartMinute])
  @@index([slotDate, activity])
  @@map("slot_allocations")
}

/// Penomoran booking berurutan per hari. Dikunci di awal transaksi booking.
model BookingDaySequence {
  bookingDate DateTime @id @map("booking_date") @db.Date
  lastNumber  Int      @default(0) @map("last_number")

  @@map("booking_day_sequences")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  userRole     Role     @map("user_role")
  /// Role yang dipakai saat aksi bila Admin bertindak sebagai petugas.
  actingAsRole Role?    @map("acting_as_role")
  action       String   @db.VarChar(60)
  bookingId    String?  @map("booking_id") @db.Uuid
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Pemindaian QR yang TIDAK menghasilkan aksi gate.
///
/// Sebelumnya pemindaian gagal tidak meninggalkan jejak sama sekali: endpoint
/// `GET /ops/scan/:qrToken` hanya melempar galat, sehingga riwayat gate berisi
/// keberhasilan saja dan justru kejadian yang perlu dipertanggungjawabkan
/// (QR palsu, tiket batal, datang terlalu awal) hilang tanpa bekas.
///
/// Yang disimpan hanya percobaan yang GAGAL. Pemindaian yang berujung gate-in
/// atau gate-out sudah tercatat di `booking_time_logs` dan `audit_logs`; bila
/// ikut ditulis di sini, setiap truk muncul dua kali di riwayat.
model ScanAttempt {
  id String @id @default(uuid()) @db.Uuid

  /// Token yang dipindai apa adanya. Untuk QR palsu nilainya tidak cocok
  /// dengan booking mana pun, jadi kolom ini sengaja tidak unik.
  qrToken String @map("qr_token") @db.VarChar(128)

  /// Kode alasan yang stabil untuk disaring dan dihitung: `INVALID_QR`,
  /// `NOT_FOUND`, `EARLY_ARRIVAL`, `APPROVAL_PENDING`,
  /// `VEHICLE_INCOMPLETE`, `WRONG_STATUS`, `CANCELLED`, `NO_SHOW`.
  reason String @db.VarChar(40)

  /// Kalimat yang dilihat petugas saat itu, disimpan agar riwayat bisa
  /// menjelaskan penolakan tanpa menebak ulang dari kode alasan.
  message String @db.VarChar(240)

  userId   String? @map("user_id") @db.Uuid
  userRole Role    @map("user_role")

  /// Terisi bila tokennya dikenali — mis. tiket batal atau datang terlalu awal.
  /// Null untuk QR yang tidak cocok dengan booking mana pun.
  bookingId String? @map("booking_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([qrToken, createdAt])
  @@map("scan_attempts")
}
