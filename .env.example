# --- Database ---
# Port 5436 dipakai karena 5432/5433/5434/5435 sudah terpakai container lain di mesin ini.
DATABASE_URL="postgresql://tsb:tsb@localhost:5436/warehouse_tsb?schema=public"

# --- API ---
PORT=4000
NODE_ENV=development
APP_ORIGIN="http://localhost:5173"

# --- Auth ---
# Ganti di produksi. Minimal 32 karakter acak.
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-0001"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-0001"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Operasional ---
# Dipakai untuk membangun URL tiket supir yang dibagikan via WhatsApp.
PUBLIC_APP_URL="http://localhost:5173"
